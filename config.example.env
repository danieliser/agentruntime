# AgentD diagnostic session logs are private, redacted, and non-canonical.
# Environment variables override command-line defaults.
AGENTD_DIAGNOSTIC_LOGS=true
AGENTD_DIAGNOSTIC_LOG_RETENTION=168h

# agentctl: process environment only (this file is not loaded automatically).
# Global --url and --as flags override their corresponding environment values.
AGENTD_URL=http://127.0.0.1:38093
AGENTD_TOKEN_FILE=$HOME/.agentd/auth.token
AGENTD_CALLER=agentctl
# PERSIST-aware ID resolution, plan supervision and owned-session controls.
PERSIST_URL=http://127.0.0.1:8803
PERSIST_TOKEN_FILE=$HOME/.local/share/persist-v3/initial_token.txt
# --cursor-dir on since/wait overrides this directory.
AGENTCTL_CURSOR_DIR=$HOME/.agentd/agentctl/cursors

# Optional isolated live acceptance overrides (normally provider-specific).
# AGENTCTL_LIVE_TEST_PORT=18091
# AGENTCTL_LIVE_TEST_MODEL=claude-haiku-4-5
