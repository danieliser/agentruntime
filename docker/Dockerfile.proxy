FROM ubuntu/squid:latest@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029

COPY squid.conf /etc/squid/squid.conf

ARG AGENTD_VERSION=dev
ARG AGENTD_COMMIT=unknown

LABEL org.opencontainers.image.title="AgentD policy proxy"
LABEL org.opencontainers.image.version="${AGENTD_VERSION}"
LABEL org.opencontainers.image.revision="${AGENTD_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/danieliser/agentruntime"

EXPOSE 3128
