FROM node:22-slim

ARG HOST_UID=1000
ARG HOST_GID=1000
ARG AGENTD_VERSION=dev
ARG AGENTD_COMMIT=unknown
ARG AGENTD_PROVIDER=all

LABEL org.opencontainers.image.title="AgentD runtime"
LABEL org.opencontainers.image.version="${AGENTD_VERSION}"
LABEL org.opencontainers.image.revision="${AGENTD_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/danieliser/agentruntime"
LABEL io.agentruntime.provider="${AGENTD_PROVIDER}"

ENV TERM=xterm-256color

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        git \
        python3 \
        python3-venv \
        ripgrep \
        tini \
	&& case "${AGENTD_PROVIDER}" in \
		all) npm install --global --no-audit --no-fund @anthropic-ai/claude-code @openai/codex ;; \
		codex) npm install --global --no-audit --no-fund @openai/codex ;; \
		claude) npm install --global --no-audit --no-fund @anthropic-ai/claude-code ;; \
		*) echo "unsupported AGENTD_PROVIDER=${AGENTD_PROVIDER}" >&2; exit 2 ;; \
	esac \
    && npm cache clean --force \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && chmod 755 /usr/local/bin/uv

# Codex checks PATH for bubblewrap before app-server initialization. Without
# the package it spends tens of seconds falling back to its bundled binary,
# exceeding AgentD's bounded native bootstrap deadline before any CONNECT.
RUN if [ "${AGENTD_PROVIDER}" = "codex" ] || [ "${AGENTD_PROVIDER}" = "all" ]; then \
		apt-get update \
		&& apt-get install -y --no-install-recommends bubblewrap \
		&& apt-get clean \
		&& rm -rf /var/lib/apt/lists/*; \
	fi

RUN if getent group "${HOST_GID}" > /dev/null; then \
      EXISTING_GROUP="$(getent group "${HOST_GID}" | cut -d: -f1)"; \
      if [ "${EXISTING_GROUP}" != "agent" ]; then \
        groupmod -n agent "${EXISTING_GROUP}"; \
      fi; \
    elif getent group agent > /dev/null; then \
      groupmod --gid "${HOST_GID}" agent; \
    else \
      groupadd -g "${HOST_GID}" agent; \
    fi \
    && if getent passwd "${HOST_UID}" > /dev/null; then \
      EXISTING_USER="$(getent passwd "${HOST_UID}" | cut -d: -f1)"; \
      if [ "${EXISTING_USER}" != "agent" ]; then \
        usermod -l agent -d /home/agent -m -g "${HOST_GID}" "${EXISTING_USER}"; \
      else \
        usermod --gid "${HOST_GID}" agent; \
      fi; \
    elif id agent > /dev/null 2>&1; then \
      usermod --uid "${HOST_UID}" --gid "${HOST_GID}" agent; \
    else \
      useradd --uid "${HOST_UID}" --gid "${HOST_GID}" --create-home --shell /bin/bash agent; \
    fi

RUN mkdir -p /home/agent/.claude /home/agent/.codex /workspace \
    && touch /home/agent/.claude.json \
    && chown -R agent:agent /home/agent /workspace

USER agent

CMD ["claude", "--version"]
